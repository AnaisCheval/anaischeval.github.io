<header class="site-header">
  <nav class="site-nav" aria-label="Main">
    <a class="site-name" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}><svg class="logo" viewBox="0 0 32 32" aria-hidden="true">{% comment %} Earth with a satellite, as the favicon: the satellite goes behind the Earth on the far half of its orbit (a second copy, drawn on top, shows only on the near half). {% endcomment %}<g transform="rotate(-28 16 16)"><ellipse class="logo-orbit" cx="16" cy="16" rx="12.6" ry="6"/><g class="logo-satellite"><rect class="satellite-panel" x="-4.2" y="-0.95" width="8.4" height="1.9" rx=".5"/><rect class="satellite-body" x="-1.45" y="-1.85" width="2.9" height="3.7" rx=".6"/><animateMotion dur="8s" repeatCount="indefinite" path="M28.6 16A12.6 6 0 1 1 3.4 16A12.6 6 0 1 1 28.6 16"/></g><circle class="logo-earth" cx="16" cy="16" r="7"/><path class="logo-orbit" d="M3.4 16A12.6 6 0 0 0 28.6 16"/><g class="logo-satellite"><rect class="satellite-panel" x="-4.2" y="-0.95" width="8.4" height="1.9" rx=".5"/><rect class="satellite-body" x="-1.45" y="-1.85" width="2.9" height="3.7" rx=".6"/><animate attributeName="opacity" values="1;0" keyTimes="0;0.5" calcMode="discrete" dur="8s" repeatCount="indefinite"/><animateMotion dur="8s" repeatCount="indefinite" path="M28.6 16A12.6 6 0 1 1 3.4 16A12.6 6 0 1 1 28.6 16"/></g></g></svg><span class="name-full">{{ site.title }}</span><span class="name-short">{{ site.short_title }}</span></a>
    <ul>
      {%- for item in navigation %}
      <li><a href="{{ item.link }}"{% if page.url == item.link %} aria-current="page"{% endif %}>{{ item.name }}</a></li>
      {%- endfor %}
      <li><button class="theme-toggle" type="button" aria-label="Switch between light and dark theme" title="Light / dark theme">{{ "sun" | icon }}<span aria-hidden="true">/</span>{{ "moon-stars" | icon }}</button></li>
    </ul>
  </nav>
</header>
